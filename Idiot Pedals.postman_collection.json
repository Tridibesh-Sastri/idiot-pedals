          "name": "GET /readyz — readiness (Mongo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/readyz", "host": ["{{baseUrl}}"], "path": ["readyz"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
