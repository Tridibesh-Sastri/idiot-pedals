    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Player\",\n  \"email\": \"PASTE_TEST_ACCOUNT_EMAIL\",\n  \"phone\": \"9000000000\",\n  \"password\": \"PASTE_TEST_ACCOUNT_PASSWORD\",\n  \"addresses\": [\n    {\n      \"label\": \"Home\",\n      \"name\": \"Test Player\",\n      \"phone\": \"9000000000\",\n      \"addressLine1\": \"1 Test Street\",\n      \"city\": \"Kolkata\",\n      \"state\": \"West Bengal\",\n      \"postalCode\": \"700001\",\n      \"country\": \"India\",\n      \"isDefault\": true\n    }\n  ]\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "description": "Starts registration and SENDS A REAL EMAIL. The account only exists after the emailed link is opened. phone must be exactly 10 digits."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "GET /api/auth/verify-email",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/verify-email?token=PASTE_VERIFICATION_TOKEN_FROM_EMAIL", "host": ["{{baseUrl}}"], "path": ["api", "auth", "verify-email"], "query": [{ "key": "token", "value": "PASTE_VERIFICATION_TOKEN_FROM_EMAIL" }] },
            "description": "Distinct outcomes: 200 EMAIL_VERIFIED, 400 EMAIL_TOKEN_INVALID, 410 EMAIL_TOKEN_EXPIRED, 409 ACCOUNT_ALREADY_VERIFIED."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"PASTE_TEST_ACCOUNT_EMAIL\",\n  \"password\": \"PASTE_TEST_ACCOUNT_PASSWORD\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "description": "Returns data.accessToken and sets the httpOnly refresh cookie. The test script saves {{accessToken}}."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);",
            "const body = pm.response.json();",
            "const token = body && body.data && body.data.accessToken;",
            "pm.expect(typeof token).to.eql('string');",
            "pm.collectionVariables.set('accessToken', token);",
            "if (pm.environment.name) { pm.environment.set('accessToken', token); }"
          ] } }]
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "POST /api/auth/refresh",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] },
            "description": "Uses the httpOnly refresh cookie (no body). Rotates the cookie and returns a new accessToken."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "GET /api/auth/google (browser only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/google", "host": ["{{baseUrl}}"], "path": ["api", "auth", "google"] },
            "description": "302 to Google. Open in a browser. Returns 302 (turn off automatic redirect following to see it)."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(302);"
          ] } }]
        },
        {
          "name": "GET /api/auth/google/callback (browser only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/google/callback", "host": ["{{baseUrl}}"], "path": ["api", "auth", "google", "callback"] },
            "description": "Google calls this. Always 302: success -> FRONTEND_URL/auth/callback, failure -> FRONTEND_URL/login?error=<code>. Without a valid code/state this returns 302 to the cancelled/state-invalid error page."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(302);"
          ] } }]
        },
        {
          "name": "NEGATIVE — GET /api/auth/me without a token",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
            "description": "No Authorization header, so the token is absent: 401."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(401);"
          ] } }]
        }
      ]
    },
    {
      "name": "Users",
