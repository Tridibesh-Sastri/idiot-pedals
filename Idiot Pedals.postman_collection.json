          ] } }]
        },
        {
          "name": "NEGATIVE — PATCH /api/users/me with a forbidden field",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"admin\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] },
            "description": "role is not whitelisted: 400, and the account is unchanged."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(400);"
          ] } }]
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "GET /api/products",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products?status=active&page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [
              { "key": "status", "value": "active" },
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "20" }
            ] },
            "description": "Public. Sends Cache-Control max-age=30 and an ETag; limit is capped at 100."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);",
            "const products = pm.response.json().data.products;",
            "if (products.length > 0) { pm.collectionVariables.set('productId', products[0]._id); }"
          ] } }]
        },
        {
          "name": "GET /api/products/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "POST /api/products (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Neon Fuzz Box\",\n  \"slug\": \"neon-fuzz-box-{{$timestamp}}\",\n  \"sku\": \"IDIOT-NFB-{{$timestamp}}\",\n  \"description\": \"Handcrafted analog fuzz pedal with aggressive vintage-style tones.\",\n  \"price\": 4999,\n  \"currency\": \"INR\",\n  \"stock\": 10,\n  \"reservedStock\": 0,\n  \"status\": \"active\",\n  \"images\": [],\n  \"specifications\": { \"type\": \"Analog Fuzz\", \"bypass\": \"True Bypass\", \"power\": \"9V DC\" }\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api", "products"] },
            "description": "Requires an ADMIN token: 201 on success."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(201);",
            "const body = pm.response.json();",
            "if (body.data && body.data.product && body.data.product._id) { pm.collectionVariables.set('productId', body.data.product._id); }"
          ] } }]
        },
        {
          "name": "PATCH /api/products/:id (admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"stock\": 25,\n  \"status\": \"active\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] },
            "description": "Requires an ADMIN token."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "DELETE /api/products/:id (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "products", "{{productId}}"] },
            "description": "Requires an ADMIN token. Destructive: deletes the product referenced by {{productId}}."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "GET /api/products (re-seed {{productId}} after DELETE)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products?status=active&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["api", "products"], "query": [
              { "key": "status", "value": "active" },
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "5" }
            ] },
            "description": "Housekeeping so the collection can be run top to bottom: the DELETE above removed the product {{productId}} pointed at, and the Orders folder needs a product that still exists. This points {{productId}} at a live catalogue product again."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);",
            "const products = pm.response.json().data.products;",
            "if (products.length > 0) { pm.collectionVariables.set('productId', products[0]._id); }"
          ] } }]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "POST /api/order — create order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1\n    }\n  ],\n  \"paymentMethod\": \"razorpay\",\n  \"customer\": {\n    \"name\": \"Test Player\",\n    \"email\": \"PASTE_TEST_ACCOUNT_EMAIL\",\n    \"phone\": \"9000000000\"\n  },\n  \"shippingAddress\": {\n    \"name\": \"Test Player\",\n    \"phone\": \"9000000000\",\n    \"addressLine1\": \"1 Test Street\",\n    \"addressLine2\": \"Near the park\",\n    \"city\": \"Kolkata\",\n    \"state\": \"West Bengal\",\n    \"postalCode\": \"700001\",\n    \"country\": \"India\"\n  }\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/order", "host": ["{{baseUrl}}"], "path": ["api", "order"] },
            "description": "Items carry productId + quantity ONLY — the server computes every price from its own catalogue. paymentMethod \"cod\" SENDS A REAL EMAIL on success; \"razorpay\" does not. Saves {{orderId}}."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(201);",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('orderId', body.order._id);",
            "// The server must never be told a price: no price/amount anywhere in the body,",
            "// and each line item must be exactly { productId, quantity }.",
            "const sent = JSON.parse(pm.request.body.raw);",
            "pm.expect(JSON.stringify(sent)).to.not.match(/price|amount|total/i);",
            "pm.expect(Object.keys(sent.items[0]).sort()).to.eql(['productId', 'quantity']);",
            "// Totals are server-computed, in integer paise.",
            "pm.expect(body.order.pricing.totalMinor).to.be.a('number');"
          ] } }]
        },
        {
          "name": "GET /api/order — list my orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/order?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "order"], "query": [
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "10" }
            ] },
            "description": "Caller-scoped. limit is capped at 50."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "GET /api/order/:orderId — order detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/order/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "order", "{{orderId}}"] },
            "description": "Owner-only. Accepts the internal ObjectId or the human-readable order number (IP-...)."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);"
          ] } }]
        },
        {
          "name": "NEGATIVE — GET another user's order",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/order/000000000000000000000000", "host": ["{{baseUrl}}"], "path": ["api", "order", "000000000000000000000000"] },
            "description": "A valid ObjectId belonging to nobody (and to nobody else either). Another user's order must return 404, never 403 — a 403 would confirm the order exists."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(404);"
          ] } }]
        },
        {
          "name": "NEGATIVE — create order with a bad quantity",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1.5\n    }\n  ],\n  \"paymentMethod\": \"razorpay\",\n  \"customer\": { \"name\": \"Test Player\", \"email\": \"PASTE_TEST_ACCOUNT_EMAIL\", \"phone\": \"9000000000\" },\n  \"shippingAddress\": { \"name\": \"Test Player\", \"phone\": \"9000000000\", \"addressLine1\": \"1 Test Street\", \"city\": \"Kolkata\", \"state\": \"West Bengal\", \"postalCode\": \"700001\", \"country\": \"India\" }\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/order", "host": ["{{baseUrl}}"], "path": ["api", "order"] },
            "description": "quantity must be an integer between 1 and 100."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(400);"
          ] } }]
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "POST /api/payments/razorpay/create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/payments/razorpay/create", "host": ["{{baseUrl}}"], "path": ["api", "payments", "razorpay", "create"] },
            "description": "Calls Razorpay with the server-computed paise total and returns its order id (saved as {{razorpayOrderId}}). Idempotent per order: calling it twice returns the SAME Razorpay order, so a double-clicked Pay button cannot create two. Requires Razorpay TEST keys."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('razorpayOrderId', body.payment.razorpayOrderId);"
          ] } }]
        },
        {
          "name": "POST /api/payments/razorpay/verify",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"razorpayPaymentId\": \"{{razorpayPaymentId}}\",\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpaySignature\": \"{{razorpaySignature}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/payments/razorpay/verify", "host": ["{{baseUrl}}"], "path": ["api", "payments", "razorpay", "verify"] },
            "description": "SENDS A REAL EMAIL on a genuine confirmation (not on a replay). Confirms but does NOT fulfil: only the webhook finalizes an order. Field names are camelCase. Replay-safe and idempotent."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(200);",
            "pm.expect(pm.response.json().orderStatus).to.not.eql('fulfilled');"
          ] } }]
        },
        {
          "name": "NEGATIVE — verify with a bad signature",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"razorpayPaymentId\": \"pay_bad_signature\",\n  \"razorpayOrderId\": \"{{razorpayOrderId}}\",\n  \"razorpaySignature\": \"invalid-signature-value\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/payments/razorpay/verify", "host": ["{{baseUrl}}"], "path": ["api", "payments", "razorpay", "verify"] },
            "description": "A forged signature is rejected before any provider call: 400."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(400);"
          ] } }]
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "POST /api/webhooks/razorpay — signed",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "const secret = pm.environment.get('razorpayWebhookSecret');",
                "if (!secret) { throw new Error('razorpayWebhookSecret is missing from the active Postman environment.'); }",
                "const rawBody = pm.request.body ? pm.request.body.raw : '';",
                "// CryptoJS is built into Postman's sandbox.",
                "const signature = CryptoJS.HmacSHA256(rawBody, secret).toString(CryptoJS.enc.Hex);",
                "pm.request.headers.upsert({ key: 'x-razorpay-signature', value: signature });"
              ] }
            },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.response.to.have.status(200);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-razorpay-event-id", "value": "evt_local_test_0001" },
              { "key": "x-razorpay-signature", "value": "REPLACED_BY_PREREQUEST_SCRIPT" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"{{razorpayPaymentId}}\",\n        \"order_id\": \"{{razorpayOrderId}}\",\n        \"amount\": 499900,\n        \"currency\": \"INR\",\n        \"status\": \"captured\"\n      }\n    }\n  }\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/webhooks/razorpay", "host": ["{{baseUrl}}"], "path": ["api", "webhooks", "razorpay"] },
            "description": "Server-to-server only — the frontend never calls this. The signature must cover the EXACT raw bytes, which is why the pre-request script signs pm.request.body.raw. This is the only path that finalizes an order (fulfilled) and consumes the stock reservation. amount must equal the order's paise total or the event is rejected."
          }
        },
        {
          "name": "NEGATIVE — webhook with a bad signature",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-razorpay-event-id", "value": "evt_local_test_bad_sig" },
              { "key": "x-razorpay-signature", "value": "invalid-signature-value" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": { \"payment\": { \"entity\": { \"id\": \"pay_rejected\", \"order_id\": \"{{razorpayOrderId}}\", \"amount\": 499900, \"currency\": \"INR\", \"status\": \"captured\" } } }\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/webhooks/razorpay", "host": ["{{baseUrl}}"], "path": ["api", "webhooks", "razorpay"] },
            "description": "Only a bad signature is a 4xx; duplicate and already-processed events return 200."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.response.to.have.status(400);"
          ] } }]
        }
      ]
    }
  ]
}
