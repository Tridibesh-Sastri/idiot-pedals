# =============================================================================
# IDIOT Pedals — server environment template
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
#
# Secrets (32+ chars for app secrets) can be generated with:
#   openssl rand -hex 32
#
# Validation happens at boot in `src/config/config.js`. The process refuses to
# start on missing/empty/placeholder values, weak secrets, a NODE_ENV vs
# Razorpay key-class mismatch, or a wildcard/path-invalid FRONTEND_URL.
# Error messages list variable NAMES only — never values.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# One of: development | test | production. If unset it defaults to
# `development` with a startup warning. Production additionally requires HTTPS
# origins and refuses localhost for MONGO_URI.
NODE_ENV=development

# HTTP port the API listens on.
PORT=5000

# Express `trust proxy` setting. Leave unset for local dev (no proxy).
# Use `true` (or the proxy hop count) when running behind Cloudflare/Nginx.
# TRUST_PROXY=true

# Opt-in ONLY: include stack traces in HTTP error responses. Ignored when
# NODE_ENV=production. Leave unset (false) everywhere else.
# DEBUG_EXPOSE_STACK=false

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# mongodb:// or mongodb+srv:// connection string.
# Refused in production if the host is localhost/127.0.0.1.
MONGO_URI=mongodb://localhost:27017/idiot_pedals

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# bcrypt cost factor, integer 8-16.
SALT_ROUND=12

# JWT signing secrets — minimum 32 characters each, high entropy, never reused.
ACCESS_TOKEN_SECRET=replace_with_openssl_rand_hex_32
REFRESH_TOKEN_SECRET=replace_with_openssl_rand_hex_32

# Signed-cookie secret (used for the OAuth state cookie + cookie-parser).
# Minimum 32 characters.
COOKIE_SECRET=replace_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Frontend origin(s)
# -----------------------------------------------------------------------------
# Comma-separated list of exact origins (scheme://host:port). Used for the CORS
# allow-list AND to build the email-verification link and OAuth redirect.
# Wildcards (`*`) and paths are rejected. The FIRST entry is treated as the
# primary origin.
#
# IMPORTANT: the SPA and the API must be same-site (same registrable domain) in
# production, because the refresh cookie is SameSite=Strict.
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Token lifetimes (milliseconds)
# -----------------------------------------------------------------------------
# Email verification link validity — default 15 minutes.
EMAIL_VERIFICATION_TOKEN_TTL_MS=900000

# Abandoned pending-registration cleanup window — default 30 minutes.
PENDING_REGISTRATION_TTL_MS=1800000

# -----------------------------------------------------------------------------
# SMTP (nodemailer — transactional email)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# `true` for implicit TLS (port 465), `false` for STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
# RFC 5322 From header, e.g. "IDIOT Pedals <no-reply@example.com>".
EMAIL_FROM="IDIOT Pedals <no-reply@example.com>"

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
# Vendor-issued secret, minimum 24 characters.
GOOGLE_CLIENT_SECRET=replace_me
# Must exactly match the redirect URI registered in Google Cloud Console and
# the server route: /api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# -----------------------------------------------------------------------------
# Razorpay
# -----------------------------------------------------------------------------
# Must start with `rzp_test_` (non-production) or `rzp_live_` (production).
# Boot fails on a NODE_ENV / key-class mismatch, so a live key can never be used
# in development and a test key can never be used in production.
RAZORPAY_KEY_ID=rzp_test_replace_me
# Vendor-issued key secret (24 characters).
RAZORPAY_KEY_SECRET=replace_me_24_chars
# Webhook signing secret configured in the Razorpay dashboard, minimum 24 chars.
RAZORPAY_WEBHOOK_SECRET=replace_me_webhook_secret

# -----------------------------------------------------------------------------
# Resend (admin order notifications)
# -----------------------------------------------------------------------------
RESEND_API_KEY=replace_me
# Sender used for admin notifications, e.g. "IDIOT Pedals <orders@example.com>".
RESEND_FROM="IDIOT Pedals <orders@example.com>"
# Receives new-order notifications.
ADMIN_ORDER_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# OUTBOUND EMAIL MASTER SWITCH
# -----------------------------------------------------------------------------
# true  = send normally (development and production)
# false = skip every send; the mailer logs "email skipped" with no recipient.
# Leave this true for normal use. Automated runs (tests, load tests, live
# checks) force it to false, and NODE_ENV=test always uses the in-memory fake
# transport instead of Resend/SMTP, so tests can never deliver real mail.
EMAIL_NOTIFICATIONS_ENABLED=true
