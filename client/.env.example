# ---------------------------------------------------------------------------
# IDIOT Pedals — client environment
#
# ONE STEP TO RUN THE APP LOCALLY:
#   1. copy this file to `.env.local`   (cp .env.example .env.local)
#   2. leave VITE_API_PROXY_TARGET as it is below
#   3. restart the dev server           (npm run dev)
#
# Skipping this is the usual cause of "We could not load the catalogue": without
# a proxy target, `/api/...` requests are answered by the Vite dev server with
# index.html instead of JSON, and the app can only show a load error.
#
# `.env.local` is git-ignored. Only VITE_-prefixed values reach the browser —
# never put a secret here.
# ---------------------------------------------------------------------------

# Dev-only: forward `/api/*` to the local Express server so the browser sees a
# same-origin API (avoids CORS + SameSite cookie friction while developing).
# This is the recommended local setting — keep it uncommented and match the
# server's PORT.
VITE_API_PROXY_TARGET="http://localhost:5000"

# Base URL for the REST API. Leave unset to use a same-origin `/api` prefix,
# which the dev proxy above (or a production reverse proxy) forwards.
# Set it when the API lives on another origin — e.g. a deployed frontend:
#   VITE_API_BASE_URL="https://api.example.com/api"
# VITE_API_BASE_URL="/api"

# Razorpay PUBLISHABLE key id (safe in the bundle — required by Razorpay Checkout).
# The Razorpay secret must stay on the server.
# VITE_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

