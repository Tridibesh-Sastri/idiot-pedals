# ---------------------------------------------------------------------------
# IDIOT Pedals — client environment
#
# ONE STEP TO RUN THE APP LOCALLY:
#   1. copy this file to `.env.local`   (cp .env.example .env.local)
#   2. keep VITE_API_PROXY_TARGET below as it is
#   3. restart the dev server           (npm run dev)
#
# Only VITE_-prefixed values reach the browser — never put a secret here.
# `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# LOCAL: proxy target for the dev server. Forwards /api/* to the local Express
# server so the browser sees a same-origin API (no CORS / SameSite friction).
# Match the server's PORT. Without it, /api requests hit Vite and return HTML.
VITE_API_PROXY_TARGET="http://localhost:5000"

# PRODUCTION: the deployed API base URL. It MUST end with /api, e.g.
#   VITE_API_BASE_URL="https://api.example.com/api"
# Leave it unset for local development (the proxy above handles /api).
# VITE_API_BASE_URL=""

# Razorpay PUBLISHABLE key id only — it is safe in the bundle because Razorpay
# Checkout runs in the browser. NEVER put the Razorpay key secret here (or in
# any other VITE_ variable): the secret stays on the server.
# VITE_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
